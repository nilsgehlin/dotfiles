#!/bin/bash
user_name=$(whoami)
projects_dir="/Users/$user_name/projects"

if [[ $# -eq 0 ]]; then
    display_names=()
    actual_dirs=()

    while IFS= read -r dir; do
        repo_name="${dir#$projects_dir/}"
        worktrees_dir="$dir/.git/worktrees"

        # Fast path: no linked worktrees, skip git call entirely
        if [[ ! -d "$worktrees_dir" ]] || [[ -z "$(ls -A "$worktrees_dir" 2>/dev/null)" ]]; then
            display_names+=("$repo_name")
            actual_dirs+=("$dir")
            continue
        fi

        # Slow path: has worktrees, need git to enumerate them
        worktree_output=$(git -C "$dir" worktree list --porcelain 2>/dev/null) || continue

        # Only process the main worktree, not linked worktrees
        main_worktree=$(echo "$worktree_output" | awk '/^worktree /{print $2; exit}')
        if [[ "$dir" != "$main_worktree" ]]; then
            continue
        fi

        first=true
        current_path=""
        branch=""

        while IFS= read -r line; do
            if [[ "$line" == worktree\ * ]]; then
                current_path="${line#worktree }"
            elif [[ "$line" == branch\ * ]]; then
                branch="${line#branch refs/heads/}"
            elif [[ -z "$line" && -n "$current_path" ]]; then
                if [[ "$first" == true ]]; then
                    display_names+=("$repo_name")
                    actual_dirs+=("$current_path")
                    first=false
                else
                    display_names+=("$repo_name:$branch")
                    actual_dirs+=("$current_path")
                fi
                current_path=""
                branch=""
            fi
        done < <(echo "$worktree_output"; echo)
    done < <(fd -L -H --type d --min-depth 3 --max-depth 3 '^\.git$' ~/projects -x echo {//})

    selected_name=$(printf '%s\n' "${display_names[@]}" | sort | fzf)

    if [[ -z "$selected_name" ]]; then
        exit 0
    fi

    selected_dir=""
    for i in "${!display_names[@]}"; do
        if [[ "${display_names[$i]}" == "$selected_name" ]]; then
            selected_dir="${actual_dirs[$i]}"
            break
        fi
    done
else
    selected_dir=$1
    selected_name=$(echo "$selected_dir" | sed "s|$projects_dir/||g")
fi

if [[ -z "$selected_dir" ]]; then
    exit 0
fi

session_name=$(echo "$selected_name" | sed 's/[\.\/:]/-/g')
tmux_running=$(pgrep tmux)

if [[ -z $tmux_running ]]; then
    tmux new-session -s "$session_name" -c "$selected_dir"
    exit 0
fi

if ! tmux has-session -t "=$session_name" 2>/dev/null; then
    tmux new-session -ds "$session_name" -c "$selected_dir"
fi

if [[ -z $TMUX ]]; then
    tmux attach -t "=$session_name" -c "$selected_dir"
    exit 0
fi

tmux switch-client -t "=$session_name"
