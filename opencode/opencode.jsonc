{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": true,
    },
    "next-mcp": {
      "type": "local",
      "command": ["npx", "-y", "next-devtools-mcp@latest"],
      "enabled": true,
    },
    "figma-mcp": {
      "type": "remote",
      "url": "http://127.0.0.1:3845/mcp",
      "enabled": true,
    },
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp",
      "enabled": true,
    },
  },
  "provider": {
    "azure-anthropic": {
      "name": "Stadium Azure (Anthropic)",
      "npm": "@ai-sdk/anthropic",
      "api": "https://aif-stadium-scoop.services.ai.azure.com/anthropic/v1",
      "models": {
        "claude-opus-4-6": {
          "name": "Claude Opus 4.6",
          "tool_call": true,
          "attachment": true,
          "reasoning": true,
          "temperature": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        }
      }
    },
    "azure-foundry": {
      "name": "Stadium Azure",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://aif-stadium-scoop.services.ai.azure.com/openai/v1"
      },
      "models": {
        "Kimi-K2.6": {
          "name": "Kimi 2.6",
          "tool_call": true,
          "reasoning": true,
          "temperature": true
        },
        "DeepSeek-V4-Pro": {
          "name": "DeepSeek V4 Pro",
          "tool_call": true,
          "reasoning": true,
          "temperature": true
        }
      }
    },
    "azure-foundry-openai": {
      "name": "Stadium Azure (OpenAI)",
      "npm": "@ai-sdk/openai",
      "api": "https://aif-stadium-scoop.services.ai.azure.com/openai/v1",
      "models": {
        "gpt-5.3-codex": {
          "name": "GPT-5.3 Codex",
          "tool_call": true,
          "attachment": true,
          "reasoning": true,
          "temperature": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        },
        "gpt-4.1-mini": {
          "name": "GPT-4.1 Mini",
          "tool_call": true,
          "attachment": true,
          "reasoning": true,
          "temperature": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        }
      }
    }
  },
  "agent": {
    "plan": {
      "model": "azure-anthropic/claude-opus-4-6"
    },
    "build": {
      "model": "azure-foundry-openai/gpt-5.3-codex",
      "temperature": 0.3
    }
  },
  "shell": "zsh",
}
